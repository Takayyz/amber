{
  "name": "amber",
  "version": "0.1.0",
  "private": true,
  "description": "A private space for sharing and preserving photos with the people who matter.",
  "license": "MIT",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "wrangler": "pnpm --filter api exec wrangler",
    "test": "pnpm --filter api test",
    "test:watch": "pnpm --filter api test:watch",
    "typecheck": "pnpm -r typecheck",
    "check:svg": "pnpm --filter web check:svg",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase migration up --local",
    "supabase:test": "supabase test db --local",
    "supabase:gen-types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts",
    "setup:r2": "bash apps/api/scripts/setup-r2.sh",
    "skills:install": "bash scripts/skills.sh",
    "skills:update": "gh skill update --all --dir .agents/skills",
    "skills:list": "gh skill list --scope project --json skillName,sourceURL,version --jq 'unique_by(.skillName)[] | \"\\(.skillName)\\t\\(.version)\\t\\(.sourceURL)\"'"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "supabase": "^2.109.1"
  }
}
